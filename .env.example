# ==========================================
# Docker Compose 环境变量配置
# ==========================================

# ==========================================
# JWT 配置（必须修改！）
# ==========================================
# 使用 openssl rand -base64 32 生成强密钥
JWT_SECRET=your-strong-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-strong-refresh-secret-key-at-least-32-characters

# ==========================================
# 会话配置（必须修改！）
# ==========================================
SESSION_SECRET=your-strong-session-secret-key

# ==========================================
# AI 服务配置（可选）
# ==========================================
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

CLAUDE_API_KEY=

# ==========================================
# 前端配置
# ==========================================
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# 监控配置（可选）
# ==========================================
SENTRY_DSN=

# Redis 密码（生产必填，为空会导致 redis 启动失败）
REDIS_PASSWORD=change-me
# PostgreSQL 密码（生产必填）
POSTGRES_PASSWORD=change-me
