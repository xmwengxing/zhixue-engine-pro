# 测试环境配置
# 注意：这是测试环境配置，不要在生产环境使用

# 数据库连接（使用与开发环境相同的数据库）
DATABASE_URL="postgresql://training_user:training_password@localhost:5432/training_platform"

# API 基础 URL
API_BASE_URL="http://localhost:3000"

# JWT 配置
JWT_SECRET="test_jwt_secret_key_for_integration_tests"
JWT_EXPIRES_IN="1h"

# Redis 配置
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# AI 服务配置（测试环境可以使用 mock）
OPENAI_API_KEY="test_openai_key"
CLAUDE_API_KEY="test_claude_key"

# 日志级别
LOG_LEVEL="error"

# 端口
PORT="3000"
