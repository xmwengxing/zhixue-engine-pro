// Prisma Schema - 智能提分训练平台数据库模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户相关表 ============

// 用户表
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  email        String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  // 家长特有字段
  realName     String?  @map("real_name")
  gender       String?
  address      String?
  industry     String?

  // 关联关系
  studentId         StudentID? @relation("UserStudentID")
  usedAuthCode      AuthCode? @relation("UsedAuthCode")
  studentProfile    StudentProfile?
  parentRelations   ParentChildRelation[] @relation("ParentRelations")
  studentRelations  ParentChildRelation[] @relation("StudentRelations")
  createdTasks      Task[] @relation("TaskCreator")
  assignedTasks     Task[] @relation("TaskAssignee")
  trainingSessions  TrainingSession[]
  errorQuestions    ErrorQuestion[]
  wishes            Wish[] @relation("StudentWishes")
  reviewedWishes    Wish[] @relation("WishReviewer")
  pointsTransactions PointsTransaction[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

// 学号表
model StudentID {
  id              String   @id @default(uuid())
  studentIdNumber String   @unique @map("student_id_number")
  status          StudentIDStatus @default(AVAILABLE)
  userId          String?  @unique @map("user_id")
  assignedAt      DateTime? @map("assigned_at")
  createdAt       DateTime @default(now()) @map("created_at")

  // 关联关系
  user User? @relation("UserStudentID", fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("student_ids")
}

// 授权码表
model AuthCode {
  id         String   @id @default(uuid())
  code       String   @unique
  status     AuthCodeStatus @default(UNUSED)
  expiryDate DateTime @map("expiry_date")
  usedBy     String?  @unique @map("used_by")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // 关联关系
  user User? @relation("UsedAuthCode", fields: [usedBy], references: [id])

  @@map("auth_codes")
}

// 学员档案表
model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  realName        String   @map("real_name")
  gender          String
  birthDate       DateTime? @map("birth_date")
  grade           String
  school          String?
  materialVersion String   @map("material_version")
  learningFoundation String? @map("learning_foundation")
  interests       String?
  subjectLevels   Json     @map("subject_levels") // { [subject: string]: 'weak' | 'average' | 'good' | 'excellent' }
  completeness    Int      @default(0) // 0-100
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// 亲子关系表
model ParentChildRelation {
  id        String   @id @default(uuid())
  parentId  String   @map("parent_id")
  studentId String   @map("student_id")
  relation  String   // 父亲/母亲/监护人
  bindedAt  DateTime @default(now()) @map("binded_at")
  status    RelationStatus @default(ACTIVE)

  // 关联关系
  parent  User @relation("ParentRelations", fields: [parentId], references: [id])
  student User @relation("StudentRelations", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_child_relations")
}

// ============ 教材相关表 ============

// 教材节点表
model MaterialNode {
  id        String   @id @default(uuid())
  name      String
  type      MaterialNodeType
  parentId  String?  @map("parent_id")
  order     Int      @default(0)
  metadata  Json     @default("{}") // { subject?: string, version?: string, unit?: string, notes?: string, keywords?: string[] }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联关系
  parent    MaterialNode?  @relation("MaterialHierarchy", fields: [parentId], references: [id])
  children  MaterialNode[] @relation("MaterialHierarchy")
  questions Question[]

  @@map("material_nodes")
}

// 题目表
model Question {
  id              String   @id @default(uuid())
  materialNodeId  String   @map("material_node_id")
  type            QuestionType
  content         Json     // 题目内容（JSON 格式）
  answer          String
  difficulty      Int      // 1-5
  knowledgePoints String[] @map("knowledge_points")
  createdAt       DateTime @default(now()) @map("created_at")

  // 题库扩展字段
  answerType   String? @map("answer_type")   // 归一化题型键，驱动输入/批改组件
  answerConfig Json?   @map("answer_config")  // 选项/正确答案/expectedLatex/几何预设等

  // 关联关系
  materialNode   MaterialNode    @relation(fields: [materialNodeId], references: [id])
  answers        Answer[]
  errorQuestions ErrorQuestion[]
  paperItems     QuestionPaperItem[]

  // 教材/单元关联（题库分类与任务调用）
  grade    String?  @map("grade")
  term     String?  @map("term")     // 学期：UP=上, DOWN=下
  version  String?  @map("version")  // 教材版本，如 人教版
  unitIds  String[] @map("unit_ids") // 关联单元节点 id（多选；materialNodeId 为首选单元）

  // ===== AI 难度归类元数据 =====
  difficultyMeta Json?   @map("difficulty_meta") // { reason, confidence:0-1, classifiedAt, standardVersion, needsReview:boolean, measuredP?:number }
  source         String? @default("IMPORT")      // IMPORT=导入 | MANUAL=手动创建 | AI_GENERATED=AI补齐入库

  // ===== AI 生成题人工复核（题库自增长飞轮）=====
  // null=无需复核（导入/手动题）；PENDING=待审核；APPROVED=已采纳；REJECTED=已驳回
  reviewStatus String?   @map("review_status")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedBy   String?   @map("reviewed_by")
  reviewNote   String?   @map("review_note")

  // ===== 知识点先修依赖（edu-learning-path 方法论，P1-3）=====
  // 该题目知识点树的前置依赖：["有理数运算","代数式"]，表示掌握这些前置知识点后再做本题更合理。
  // 用途：① 学情 blocks_followup 判定（前置未掌握→阻塞后续）；② 出题/组卷排序优先补前置。
  // 维护入口：管理端题库「知识点先修关系」（按学科批量写回该学科含对应知识点的题目）。
  prerequisites Json? // { "知识点": ["先修1","先修2"] } 或 ["先修1","先修2"]

  @@index([grade, term, difficulty])
  @@index([reviewStatus])
  @@map("questions")
}

// 试卷表（一套卷，归属某科目）
model QuestionPaper {
  id         String      @id @default(uuid())
  subject    String                         // 复用 SubjectInstruction.subject
  title      String
  grade      String?
  sourceFile String?     @map("source_file") // 上传原件路径
  status     PaperStatus @default(DRAFT)    // DRAFT -> NORMALIZED -> PUBLISHED
  createdBy  String      @map("created_by")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  // 教材关联与试卷类型（分类 / 任务调用）
  term       String?   @map("term")       // 学期：UP=上, DOWN=下
  version    String?   @map("version")    // 教材版本，如 人教版
  paperType  PaperType @default(UNIT) @map("paper_type") // 单元练习/期中/期末/中考/高考
  unitIds    String[]  @map("unit_ids")   // 关联单元节点 id（多选）
  textbookId String?   @map("textbook_id") // 关联教材(教材体系 TEXTBOOK 节点) id

  // 题库分类：习题与试卷(EXERCISE) / 初测与水平评估(ASSESSMENT)
  // ASSESSMENT 库专门用于任务初测或水平评估，不区分难度，训练舱初测可从中提取套卷或组合
  category   QuestionPaperCategory @default(EXERCISE) @map("category")

  items QuestionPaperItem[]
  importJobs QuestionImportJob[]

  @@map("question_papers")
}

// 卷内题目（带顺序与分值）
model QuestionPaperItem {
  id         String   @id @default(uuid())
  paperId    String   @map("paper_id")
  questionId String   @map("question_id")
  order      Int      @default(0)
  score      Int      @default(0)

  paper    QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([paperId, questionId])
  @@map("question_paper_items")
}

// ============ 任务和训练相关表 ============

// 任务表
model Task {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  createdBy   String   @map("created_by")
  title       String
  mode        TaskMode
  config      Json     // { materialNodeIds: string[], questionCount: number, difficulty: number }
  status      TaskStatus @default(PENDING)
  createdAt   DateTime @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // ===== 任务双轨制字段 =====
  category    TaskCategory     @default(SUBJECT_MAIN) // 学科总任务 / 专项攻克
  subject     String?                                  // 学科（一级字段，从 config 提升）
  specialType SpecialTaskType? @map("special_type")    // 专项类型（仅 SPECIAL）
  targetRef   Json?            @map("target_ref")      // 专项目标 {unitIds:[]}|{knowledgePoints:[]}|{errorQuestionIds:[]}

  // ===== 学期延续模式字段 =====
  archivedAt DateTime? @map("archived_at") // 学期归档时间（归档后置位，学科总任务即告一段落）

  // 关联关系
  student          User              @relation("TaskAssignee", fields: [studentId], references: [id])
  creator          User              @relation("TaskCreator", fields: [createdBy], references: [id])
  trainingSessions TrainingSession[]
  reports          Report[]
  archive          TaskArchive?      // 学期归档（外键在 TaskArchive.taskId）

  @@index([studentId, category, subject])
  @@map("tasks")
}

// ===== 学期归档表（学科总任务延续模式：一学期一归档）=====
// 归档节点：该学期期末考训练完成并达成分数目标后，由家长手动触发。
// summaryText 为压缩后的学期总结（供新学期 AI 读取，替代全量历史，降低 token 消耗）。
model TaskArchive {
  id               String   @id @default(uuid())
  taskId           String   @unique @map("task_id")
  studentId        String   @map("student_id")
  subject          String
  semesterLabel    String   @map("semester_label")      // 如 "2026-08 学期"
  summaryText      String   @map("summary_text") @db.Text // AI 学期总结（失败降级为统计文本）
  summaryJson      Json     @map("summary_json") @db.JsonB // 结构化统计 { initialTestAccuracy, rounds, avgAccuracy, finalExamAccuracy, totalQuestions, correctCount, weakPoints, masteredPoints }
  goalScore        Int?     @map("goal_score")          // 期末目标正确率 %
  finalExamAccuracy Float?  @map("final_exam_accuracy") // 期末实际正确率 %
  archivedAt       DateTime @default(now()) @map("archived_at")

  // 关联关系
  task Task @relation(fields: [taskId], references: [id])

  @@index([studentId, subject, archivedAt])
  @@map("task_archives")
}

// 训练会话表
model TrainingSession {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  studentId   String   @map("student_id")
  phase       TrainingPhase
  currentStep Int      @default(0) @map("current_step")
  totalSteps  Int      @map("total_steps")
  progress    Int      @default(0) // 0-100
  questions   String[] // 题目 ID 列表
  status      SessionStatus @default(ACTIVE)
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  // 档案提取模式专用字段
  diagnosticTestData Json?    @map("diagnostic_test_data") @db.JsonB // 诊断测试数据：{ totalQuestions, currentQuestion, answers: [], results?: {} }
  trainingPlanData   Json?    @map("training_plan_data") @db.JsonB   // 训练计划数据：完整的训练计划对象
  trainingProgress   Json?    @map("training_progress") @db.JsonB    // 训练阶段进度：{ currentStage, stages: { foundation: {}, improvement: {}, application: {} } }
  finalExamData      Json?    @map("final_exam_data") @db.JsonB      // 综合考试数据：{ questions: [], answers: {}, results?: {} }
  trainingReport     String?  @map("training_report") @db.Text       // 训练报告：Markdown 格式的完整报告

  // 断点续答锚点：最近一次「已下发但未提交」的题目快照
  // { phase, questionNumber, totalQuestions, question, issuedAt }
  lastQuestionSnapshot Json?  @map("last_question_snapshot") @db.JsonB

  // 关联关系
  task            Task              @relation(fields: [taskId], references: [id])
  student         User              @relation(fields: [studentId], references: [id])
  answers         Answer[]
  aiConversations AIConversation[]
  report          Report?

  @@map("training_sessions")
}

// 答题记录表
model Answer {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  // 可空：AI 现场生成题若沉淀 Question 失败，仍需保住作答记录（用 questionSnapshot 兜底）
  questionId    String?  @map("question_id")
  studentAnswer String   @map("student_answer")
  isCorrect     Boolean  @map("is_correct")
  timeSpent     Int      @map("time_spent") // 秒
  attemptCount  Int      @default(1) @map("attempt_count")
  answeredAt    DateTime @default(now()) @map("answered_at")

  // 电子答题扩展字段
  answerData  Json?   @map("answer_data")  // 结构化答案（按 answerType 组织）
  inputMethod String? @map("input_method") // click|keyboard|formula|geogebra|desmos|handwriting|photo
  // 题面快照：questionId 为空（或题目后续被删）时仍能还原题干做报告/错题本
  questionSnapshot Json? @map("question_snapshot") @db.JsonB

  // 关联关系
  session        TrainingSession @relation(fields: [sessionId], references: [id])
  question       Question?       @relation(fields: [questionId], references: [id])
  errorQuestions ErrorQuestion[]

  @@map("answers")
}

// AI 对话表
model AIConversation {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  questionId String?  @map("question_id")
  role       ConversationRole
  message    String   @db.Text
  timestamp  DateTime @default(now())

  // 关联关系
  session TrainingSession @relation(fields: [sessionId], references: [id])

  @@map("ai_conversations")
}

// 报告表
model Report {
  id          String   @id @default(uuid())
  sessionId   String   @unique @map("session_id")
  studentId   String   @map("student_id")
  taskId      String   @map("task_id")
  content     Json     @db.JsonB // 报告内容（JSON 格式）
  generatedAt DateTime @default(now()) @map("generated_at")

  // ===== 学科化报告字段 =====
  subject     String?                                  // 学科（可回溯标"综合"）
  category    TaskCategory     @default(SUBJECT_MAIN)  // 总任务报告 / 专项报告
  specialType SpecialTaskType? @map("special_type")    // 专项类型（仅 SPECIAL）

  // 关联关系
  session TrainingSession @relation(fields: [sessionId], references: [id])
  task    Task            @relation(fields: [taskId], references: [id])

  @@index([studentId, subject, category])
  @@map("reports")
}

// ============ 错题和积分相关表 ============

// 错题表
model ErrorQuestion {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  questionId  String   @map("question_id")
  answerId    String   @map("answer_id")
  subject     String
  mastery     MasteryLevel @default(UNMASTERED)
  retryCount  Int      @default(0) @map("retry_count")
  lastRetryAt DateTime? @map("last_retry_at")
  collectedAt DateTime @default(now()) @map("collected_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ===== 艾宾浩斯间隔重复（Spaced Repetition）字段 =====
  reviewStage        Int       @default(0) @map("review_stage")          // 当前复习阶段：0=未开始，1/2/3/4 对应第 1/3/7/15 天周期
  consecutiveCorrect Int       @default(0) @map("consecutive_correct")   // 连续复习答对次数（跨周期），答错清零
  nextReviewAt       DateTime? @map("next_review_at")                    // 下次到期复习时间（归档后为 null）
  reviewHistory      Json?     @map("review_history") @db.JsonB          // 复习轨迹 [{ stage, isCorrect, reviewedAt }]

  // 关联关系
  student  User     @relation(fields: [studentId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
  answer   Answer   @relation(fields: [answerId], references: [id])

  @@map("error_questions")
}

// 愿望表
model Wish {
  id             String     @id @default(uuid())
  studentId      String     @map("student_id")
  type           WishType   @default(CUSTOM) // 愿望类型：现金或自定义
  description    String     @db.Text
  requiredPoints Int        @map("required_points")
  imageUrl       String?    @map("image_url")
  status         WishStatus @default(PENDING)
  reviewedBy     String?    @map("reviewed_by")
  reviewReason   String?    @map("review_reason") @db.Text
  confirmedAt    DateTime?  @map("confirmed_at") // 学员确认时间
  submittedAt    DateTime   @default(now()) @map("submitted_at")
  reviewedAt     DateTime?  @map("reviewed_at")
  fulfilledAt    DateTime?  @map("fulfilled_at")

  // 关联关系
  student  User  @relation("StudentWishes", fields: [studentId], references: [id])
  reviewer User? @relation("WishReviewer", fields: [reviewedBy], references: [id])

  @@map("wishes")
}

// 积分交易表
model PointsTransaction {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  amount    Int      // 正数为获得，负数为消耗
  type      TransactionType
  relatedId String?  @map("related_id") // 关联 ID（任务/错题/愿望）
  balance   Int      // 交易后余额
  createdAt DateTime @default(now()) @map("created_at")

  // 关联关系
  student User @relation(fields: [studentId], references: [id])

  @@map("points_transactions")
}

// ============ 学科学情与智能体平台 ============

// 学科学情档案（每生每科一条，持续滚动更新）
model SubjectLearningState {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  subject     String
  irtTheta    Float?   @map("irt_theta")      // 能力估计值（从会话 IRT 汇聚）
  masteryMap  Json     @default("{}") @map("mastery_map")  // { 知识点: {score:0-100, trend:'up'|'down'|'flat', lastAt, source?:'main'|'special'} }
  weakPoints  Json     @default("[]") @map("weak_points")  // 薄弱点排序列表 [{point, score, priority}]
  errorStats  Json     @default("{}") @map("error_stats")  // 错题分布快照 { total, byMastery, byKnowledgePoint }
  taskHistory Json     @default("[]") @map("task_history") // 总任务履历摘要 [{taskId, title, completedAt, completion, score}]
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([studentId, subject])
  @@index([studentId])
  @@map("subject_learning_states")
}

// 智能体文档类型
enum AgentDocType {
  FLOW          // 系统化流程（训练舱各阶段该怎么走）
  INSTRUCTION   // 内部指令（角色设定、教学法、语气）
  CONSTRAINT    // 约束（红线：不代答、不超纲、不讨论无关话题）
  STANDARD      // 判定标准（如题目难度归类标准）
  MEMORY_SPEC   // 记忆文档撰写规范（AI 写记忆时遵循的格式）
}

// 智能体文档（管理端 CRUD，训练舱 AI 上下文装配来源）
model AgentDocument {
  id        String       @id @default(uuid())
  type      AgentDocType
  subject   String?      // null=全局通用，非空=学科专属（学科覆盖全局）
  title     String
  content   String       @db.Text // Markdown
  version   Int          @default(1)
  enabled   Boolean      @default(true)
  priority  Int          @default(100) // 注入顺序，越小越靠前
  updatedBy String       @map("updated_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([type, subject, enabled])
  @@map("agent_documents")
}

// 学员记忆文档（AI 维护；家长只读可见，学员不可见）
model StudentMemory {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  subject   String?  // null=全局记忆（学习习惯/性格），非空=学科记忆
  content   String   @db.Text // Markdown，AI 维护，限长 4000 字
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logs StudentMemoryLog[]

  @@unique([studentId, subject])
  @@index([studentId])
  @@map("student_memories")
}

// 学员记忆修订快照（审计/回滚）
model StudentMemoryLog {
  id        String   @id @default(uuid())
  memoryId  String   @map("memory_id")
  sessionId String?  @map("session_id") // 触发本次修订的训练会话
  content   String   @db.Text           // 修订后的完整内容快照
  summary   String?                     // 本次增量摘要
  createdAt DateTime @default(now()) @map("created_at")

  memory StudentMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId, createdAt])
  @@map("student_memory_logs")
}

// 平台配置（键值对：如 AI 补题开关）
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ============ AI 服务相关表 ============

// AI 服务商表
model AIProvider {
  id        String   @id @default(uuid())
  name      String
  type      AIProviderType
  apiKey    String   @map("api_key") // 加密存储
  endpoint  String
  model     String
  priority  Int      @default(0) // 数字越小优先级越高
  status    ProviderStatus @default(ACTIVE)
  // —— 模型级配置（管理员可配，用于兼容文本生成 / 推理模型并优化延迟）——
  contextWindow    Int?     @map("context_window") // 模型最长上下文（自动探测或手动填写），用于约束 max_tokens / 注入 Ollama num_ctx
  maxTokens        Int?     @map("max_tokens") // 单次输出最大 token（留空=各适配器官方默认）
  streamEnabled    Boolean  @default(false) @map("stream_enabled") // 是否允许流式响应
  supportsReasoning Boolean  @default(false) @map("supports_reasoning") // 是否为推理模型（输出可能落在 reasoning 字段）
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联关系
  apiLogs APILog[]

  @@map("ai_providers")
}

// OCR / 视觉识别服务商配置（管理端可配置，供试卷导入与学员/家长图片识别使用）
// - LOCAL_SERVICE：本地 Unlimited-OCR 推理服务（仅 endpoint）
// - LOCAL_VISION：本地视觉模型（Ollama 原生 /api/chat，需 endpoint + model）
// - CUSTOM_API：自定义厂商视觉模型（OpenAI 兼容 /chat/completions，需 endpoint + apiKey + model）
// enableForRecognition：是否作为学员/家长「图片→文本」识别通道（仅 CUSTOM_API 可勾选，满足非本地要求）
model OcrProvider {
  id                   String        @id @default(uuid())
  name                 String
  method               OcrMethod
  endpoint             String
  apiKey               String?       @map("api_key") // 仅 CUSTOM_API 需要
  model                String?       @map("model")   // 视觉模型名（LOCAL_VISION / CUSTOM_API）
  isDefault            Boolean       @default(false) // 管理端导入默认使用
  enableForRecognition Boolean       @default(false) // 作为学员/家长识别通道（仅 CUSTOM_API）
  status               ProviderStatus @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@map("ocr_providers")
}

// 科目教学指令表
model SubjectInstruction {
  id           String   @id @default(uuid())
  subject      String   @unique
  systemPrompt String   @map("system_prompt") @db.Text
  examples     Json     @default("[]") // { question: string, response: string }[]
  providerId   String?  @map("provider_id") // 关联的 AI 服务商 ID
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("subject_instructions")
}

// API 日志表
model APILog {
  id             String   @id @default(uuid())
  providerId     String   @map("provider_id")
  endpoint       String
  requestTokens  Int      @map("request_tokens")
  responseTokens Int      @map("response_tokens")
  responseTime   Int      @map("response_time") // 毫秒
  status         LogStatus
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  // 关联关系
  provider AIProvider @relation(fields: [providerId], references: [id])

  @@map("api_logs")
}

