# ==========================================
# 服务器配置
# ==========================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==========================================
# 数据库配置
# ==========================================
# PostgreSQL 连接字符串格式：postgresql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/training_platform?schema=public"

# 数据库连接池配置
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==========================================
# Redis 配置
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL=3600

# ==========================================
# JWT 配置
# ==========================================
# 生产环境请使用强密钥（建议使用 openssl rand -base64 32 生成）
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# AI 服务配置
# ==========================================
# OpenAI 配置
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Claude 配置
CLAUDE_API_KEY=sk-ant-your-claude-api-key
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=2000

# AI 服务通用配置
AI_REQUEST_TIMEOUT=30000
AI_MAX_RETRIES=3
AI_RATE_LIMIT_PER_MINUTE=60

# ==========================================
# 文件上传配置
# ==========================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_DEST=./uploads

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# ==========================================
# 安全配置
# ==========================================
# 密码加密轮次（建议 10-12）
BCRYPT_ROUNDS=10

# 会话配置
SESSION_SECRET=your-session-secret-change-in-production

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# 邮件配置（可选）
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@example.com

# ==========================================
# 通知配置（可选）
# ==========================================
NOTIFICATION_ENABLED=true
NOTIFICATION_WEBHOOK_URL=

# ==========================================
# 监控配置（可选）
# ==========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ==========================================
# 其他配置
# ==========================================
# 应用基础 URL
APP_BASE_URL=http://localhost:3000

# 前端应用 URL
FRONTEND_URL=http://localhost:5173

# API 版本
API_VERSION=v1
