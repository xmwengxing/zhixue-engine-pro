# ==========================================
# DataWork 试卷转换与入库 环境变量配置
# ==========================================
# 复制本文件为 .env 并填入实际值
# cp .env.example .env

# ------------------------------------------
# 飞桨 PaddleOCR API Key（转换脚本使用）
# ------------------------------------------
# 获取方式：https://paddleocr.aistudio.com.cn/ 申请 API Key
# 日额度：20000 页，推荐使用（OCR 质量最佳）
# 如不填写，脚本将通过 Docker DB 查询（仅限开发环境）
PADDLE_API_KEY=

# ------------------------------------------
# Python 解释器路径（可选）
# ------------------------------------------
# 需要安装：pymupdf, requests, pdf-parse
# 留空则自动检测系统 PATH 中的 python3
# PYTHON_PATH=/usr/bin/python3

# ------------------------------------------
# 项目路径（可选，留空自动检测）
# ------------------------------------------
# 通常无需修改，脚本会根据自身位置自动计算
# PAPER_ROOT=/path/to/SourceData
# OUT_DIR=/path/to/OutputData
