# ==========================================
# API 配置
# ==========================================
# API 基础 URL（后端服务地址）
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# 应用配置
# ==========================================
# 应用环境：development | staging | production
VITE_APP_ENV=development

# 应用标题
VITE_APP_TITLE=智能提分训练平台

# 应用版本
VITE_APP_VERSION=1.0.0

# ==========================================
# 功能开关
# ==========================================
# 启用调试模式
VITE_ENABLE_DEBUG=true

# 启用性能监控
VITE_ENABLE_PERFORMANCE_MONITOR=false

# 启用错误追踪
VITE_ENABLE_ERROR_TRACKING=false

# ==========================================
# 第三方服务配置（可选）
# ==========================================
# Sentry DSN（错误追踪）
VITE_SENTRY_DSN=

# Google Analytics ID
VITE_GA_ID=

# ==========================================
# 上传配置
# ==========================================
# 最大文件上传大小（字节）
VITE_MAX_FILE_SIZE=10485760

# 允许的文件类型
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# ==========================================
# UI 配置
# ==========================================
# 默认语言
VITE_DEFAULT_LOCALE=zh-CN

# 主题色
VITE_PRIMARY_COLOR=#1890ff

# ==========================================
# 缓存配置
# ==========================================
# 本地存储前缀
VITE_STORAGE_PREFIX=training_platform_

# 缓存过期时间（毫秒）
VITE_CACHE_EXPIRY=3600000
